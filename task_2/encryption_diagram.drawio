        <mxCell id="start" parent="1" vertex="1" value="Начало" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="375.0" y="22.0" width="150" height="46" />
        </mxCell>
        <mxCell id="input" parent="1" vertex="1" value="Ввод text" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="335.0" y="97.5" width="230" height="65" />
        </mxCell>
        <mxCell id="replace" parent="1" vertex="1" value="text = text.replace(&quot;,&quot;, &quot; &quot;).replace(&quot;.&quot;, &quot; &quot;)&lt;br&gt;Замена запятых и точек пробелами" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="235.0" y="185.0" width="430" height="100" />
        </mxCell>
        <mxCell id="init" parent="1" vertex="1" value="words = text.split(&quot; &quot;)&lt;br&gt;alphabet = &quot;abcdefghijklmnopqrstuvwxyz&quot;&lt;br&gt;encrypted = &quot;&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="235.0" y="320.0" width="430" height="110" />
        </mxCell>
        <mxCell id="k" parent="1" vertex="1" value="k = max((len(word) for word in words),&lt;br&gt;default=0)&lt;br&gt;Длина самого длинного элемента words" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="235.0" y="465.0" width="430" height="100" />
        </mxCell>
        <mxCell id="loop" parent="1" vertex="1" value="Для каждого char из text" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="290.0" y="610.0" width="320" height="90" />
        </mxCell>
        <mxCell id="letter" parent="1" vertex="1" value="char.lower() in alphabet?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="290.0" y="740.0" width="320" height="110" />
        </mxCell>
        <mxCell id="shift" parent="1" vertex="1" value="index_in_alp = alphabet.find(char.lower())&lt;br&gt;new_char = alphabet[(index_in_alp+k) % 26]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="235.0" y="880.0" width="430" height="90" />
        </mxCell>
        <mxCell id="upper" parent="1" vertex="1" value="char.isupper()?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="320.0" y="1005.0" width="260" height="90" />
        </mxCell>
        <mxCell id="yes" parent="1" vertex="1" value="encrypted += new_char.upper()" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="80.0" y="1132.5" width="310" height="65" />
        </mxCell>
        <mxCell id="no" parent="1" vertex="1" value="encrypted += new_char" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="500.0" y="1132.5" width="260" height="65" />
        </mxCell>
        <mxCell id="other" parent="1" vertex="1" value="encrypted += char" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
          <mxGeometry as="geometry" x="770.0" y="892.5" width="240" height="65" />
        </mxCell>
        <mxCell id="output" parent="1" vertex="1" value="Вывод &quot;encrypted : &quot;, encrypted&lt;br&gt;Вывод &quot;K : &quot;, k" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;">
